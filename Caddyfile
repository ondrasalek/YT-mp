# Caddy reverzní proxy s automatickým HTTPS (Let's Encrypt).
#
# Nastav doménu a e-mail přes proměnné prostředí (viz docker-compose.yml):
#   DOMAIN=ytmp.example.com
#   ACME_EMAIL=ty@example.com
#
# Bez DOMAIN se použije "localhost" (Caddy vystaví self-signed cert pro
# lokální testování přes https://localhost).

{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	# flush_interval -1 = bez bufferování -> SSE proud (progress) teče v reálném čase.
	reverse_proxy ytmp:8080 {
		flush_interval -1
	}

	# Limit velikosti těla i na úrovni proxy (URL jsou malé).
	request_body {
		max_size 64KB
	}

	header {
		# HSTS (jen pokud běžíš na HTTPS s reálnou doménou).
		Strict-Transport-Security "max-age=31536000;"
		-Server
	}
}
