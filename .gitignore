# Rust / Tauri build output
/desktop/src-tauri/target/

# Tauri generated schemas (regenerated on build)
/desktop/src-tauri/gen/

# Přibalené binárky (yt-dlp, ffmpeg) — stahuje je scripts/fetch-binaries.sh,
# do gitu nepatří (velké, platformově závislé).
/desktop/src-tauri/binaries/*
!/desktop/src-tauri/binaries/.gitignore

# Python (lokální venv, pokud zůstane)
.venv/
__pycache__/
*.pyc

# Výstupy / dočasná data
/downloads/
/data/

# macOS
.DS_Store
