{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT-mp",
  "version": "0.4.0",
  "identifier": "com.slks.ytmp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YT-mp — YouTube → MP3/MP4",
        "width": 820,
        "height": 940,
        "minWidth": 820,
        "minHeight": 820,
        "maxWidth": 1200,
        "maxHeight": 1500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
